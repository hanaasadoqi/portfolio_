// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  pool     = 5
  pgBouncer = true
}

model Skill {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String     @unique
  icon            String?
  startYear       Int
  documentation   String?
  categories      String[]
  tags            String[]
  series          Series[]   @relation("SeriesSkills")
  projects        Project[]  @relation("ProjectSkills")
  articles        Article[]  @relation("ArticleSkills")
  experiences     WorkExperience[]  @relation("WorkExperienceSkills")
  educations      Education[] @relation("EducationSkills")
  educationId     String?    @db.Uuid
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([name])
  @@map("skills")
}

model Asset {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order           Int?
  title           String
  description     String?
  src             String
  alt             String?
  poster          String?
  path            String?
  aspectRatio     String?
  type            String?
  category        String?
  srcSet          String?
  sizes           String?
  articleId       String?    @db.Uuid
  projectId       String?    @db.Uuid
  article         Article?   @relation(fields: [articleId], references: [id])
  project         Project?   @relation(fields: [projectId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([type])
  @@index([category])
  @@map("assets")
}

model Article {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  subtitle        String
  type            String?
  category        String?
  description     String?
  fileContent     String?
  image           String
  slug            String?   @unique
  published       Boolean?  @default(false)   
  publishedDate   String?
  medium          String?
  hashnode        String?
  tags            String[]
  viewCount       Int       @default(0)
  likeCount       Int       @default(0)
  assets          Asset[]
  comments        Comment[]
  seriesId        String?   @db.Uuid
  series          Series?   @relation(fields: [seriesId], references: [id])
  skills          Skill[]   @relation("ArticleSkills")
  projects        Project[] @relation("ProjectArticles")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([title])
  @@map("articles")
}

model Project {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image           String
  title           String 
  description     String
  category        String
  demoUrl         String?
  frontendRepo    String?
  backendRepo     String?
  codeRepo        String?
  videoDemo       String?
  launchDate      String?
  status          String
  slug            String?    
  fileContent     String?
  tags            String[]
  assets          Asset[]
  comments        Comment[]
  skills          Skill[]    @relation("ProjectSkills")
  articles        Article[]  @relation("ProjectArticles")
  viewCount       Int        @default(0)
  likeCount       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([category])
  @@index([status, category])
  @@index([tags, title])
  @@index([status, category, tags, title])
  @@map("projects")
}

model Series {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  description     String?
  category        String?
  type            String?
  tags            String[]
  skills          Skill[]   @relation("SeriesSkills")
  articles        Article[] 
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("series")
}

model Comment {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author          String
  message         String
  articleId       String?    @db.Uuid
  projectId       String?    @db.Uuid
  article         Article?   @relation(fields: [articleId], references: [id])
  project         Project?   @relation(fields: [projectId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("comments")
}

model Education {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  degree        String?      
  school        String
  location      String?
  startDate     String
  endDate       String?
  skills        Skill[]     @relation("EducationSkills")
  url           String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("educations")
}

model WorkExperience {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company     String        
  role        String
  location    String?
  startDate   String
  endDate     String?
  url         String?
  logo        String?
  description String[]
  skills      Skill[]       @relation("WorkExperienceSkills")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("work_experiences")
}