generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Supabase connection string
  directUrl = env("DIRECT_URL")
}

// Skills Table
model Skill {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  name          String
  icon          String
  startYear     BigInt   @map("start_year")
  documentation String?
  categories      String[]
  tags          String[]

  // Many-to-many relations (implicit)
  projects        Project[]         @relation("projects_skills")
  workExperiences WorkExperience[]  @relation("work_experiences_skills")
  articles        Article[]         @relation("articles_skills")
  schools         Education[]       @relation("schools_skills")

  @@map("skills")
}

// Projects Table
model Project {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  title        String
  description  String
  category     String
  image        String?
  backendRepo  String?
  frontendRepo String?
  codeRepo     String?
  demoUrl      String?
  videoDemo    String?
  launchDate   DateTime?
  status       String
  tags         String[]

  // Many-to-many relations (implicit)
  skills    Skill[]    @relation("projects_skills")
  articles  Article[]  @relation("projects_articles")

  @@map("projects")
}

// Work Experience Table
model WorkExperience {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  company     String
  website     String?
  role        String
  location    String
  startDate   DateTime
  endDate     DateTime?
  logo        String?
  description String[]

  // Many-to-many relations (implicit)
  skills  Skill[]  @relation("work_experiences_skills")

  @@map("work_experiences")
}

// Education Table
model Education {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  school    String
  degree    String
  location  String
  startDate DateTime
  endDate   DateTime?
  url       String?

  // Many-to-many relations (implicit)
  skills  Skill[]  @relation("schools_skills")

  @@map("schools")
}

// Articles Table
model Article {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  type          String
  title         String
  description   String
  image         String?
  publishedDate DateTime
  tags          String[]
  url           String?
  hashnode      String?
  medium        String?

  // Many-to-many relations (implicit)
  skills    Skill[]   @relation("articles_skills")
  projects  Project[] @relation("projects_articles")

  @@map("articles")
}
