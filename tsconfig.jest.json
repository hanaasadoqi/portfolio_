{
  "compilerOptions": {
    "jsx": "react",
    "allowJs": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "target": "es5"
  },
  "include": [ "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx" ]
}